# Wordpress - Plugins

# Log files
*.log

# htaccess
/.htaccess

# OS system file
.DS_Store
Thumbs.db

# VS code / editors
.vscode/
.idea/

# node and composer
# composer.lock IS tracked so CI and every developer install the same tooling.
/node_modules/
vendor
package-lock.json

# translated files
/i18n/*.mo
/i18n/*.po

# Optional npm cache directory
*.npm

# dotenv environment variables file
.env

# wp-env local overrides (ports etc. belong in .wp-env.json, see docs/development.md)
.wp-env.override.json

# PHPUnit / local tooling caches
.phpunit.result.cache
/dist/

# Claude Code local settings
.claude/settings.local.json

*.tmp
*.zip
*.js.map
*.css.map
# Distribution directory
dist/
